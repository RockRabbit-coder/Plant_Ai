# PlantCare AI - Environment Configuration Example
PROJECT_NAME="PlantCare AI"
VERSION="1.0.0"

# Database Configuration (SQLite default; PostgreSQL supported)
DATABASE_URL="sqlite+aiosqlite:///./plantcare.db"
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/plantcare"

# PyTorch Model Configuration
MODEL_PATH="./ml/models/plantcare_mobilenetv3.pth"
CONFIDENCE_THRESHOLD=0.40
BLUR_THRESHOLD=40.0
MIN_IMAGE_DIM=100
MAX_FILE_SIZE_MB=15

# Weather API (Optional - OpenWeatherMap API Key)
OPENWEATHER_API_KEY=""

# Agricultural Assistant Generative LLM (Optional - Gemini or OpenAI API Key)
# If left blank, the application automatically uses the verified local botanical knowledge base
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000","*"]
